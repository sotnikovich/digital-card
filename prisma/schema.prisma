// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// prisma/schema.prisma
model Profile {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  githubUrl   String?
  linkedinUrl String?
  
  // Связи
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id])
}

model Experience {
  id          Int     @id @default(autoincrement())
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  achievements String[]
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id])
}

model Project {
  id        Int     @id @default(autoincrement())
  name      String
  url       String?
  repoUrl   String?
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id])
}